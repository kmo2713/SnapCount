# ---------------------------------------------------------------------------
# Snap Count environment
# Copy to .env.local for `next dev`, and .env for the CLI sync scripts.
# ---------------------------------------------------------------------------

# Postgres connection string. Supabase: Project Settings -> Database ->
# Connection string -> URI (use the "Session pooler" / port 5432 URI for
# migrations, the pooled 6543 URI is fine for the app).
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Your Sleeper username. No API key exists or is needed.
SLEEPER_USERNAME=kmo2713

# Which NFL season to sync. Leave blank to follow Sleeper's /state/nfl.
# SNAP_COUNT_SEASON=2026

# Shared secret required by POST /api/sync so the endpoint is not open to the
# internet once deployed. Generate with: openssl rand -hex 32
SYNC_SECRET=

# Claude-generated start/sit and trade analysis. Optional: without it the
# built-in heuristics still run and the rest of the app is unaffected.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- ESPN ------------------------------------------------------------------
# ESPN publishes no API and no tokens. A private league is read with the two
# cookies your browser already holds, copied by hand from a logged-in session:
#
#   1. Log in at https://fantasy.espn.com and open DevTools (F12)
#   2. Application -> Storage -> Cookies -> https://fantasy.espn.com
#   3. Copy the values of `espn_s2` and `SWID`
#
# SWID keeps its braces: {XXXXXXXX-XXXX-...}. They are re-added if you drop
# them, but paste them if you have them. Both values are as good as a password
# for your ESPN account — they belong here, never in source.
#
# Verify with `npm run espn:check` before syncing anything.
ESPN_S2=
ESPN_SWID=

# Comma-separated league ids, from the address bar of any league page:
# https://fantasy.espn.com/football/team?leagueId=1597896928&seasonId=2026
ESPN_LEAGUE_IDS=

# --- Not wired up (Yahoo — out of scope) -----------------------------------
# The only Yahoo league here is college fantasy, which this app does not model.
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
# YAHOO_REDIRECT_URI=http://localhost:3000/api/auth/yahoo/callback
# CREDENTIAL_ENCRYPTION_KEY=   # 32-byte hex, for encrypting stored tokens/cookies
