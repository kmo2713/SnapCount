# ---------------------------------------------------------------------------
# Snap Count environment
# Copy to .env.local for `next dev`, and .env for the CLI sync scripts.
# ---------------------------------------------------------------------------

# Postgres connection string. Supabase: Project Settings -> Database ->
# Connection string -> URI (use the "Session pooler" / port 5432 URI for
# migrations, the pooled 6543 URI is fine for the app).
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Your Sleeper username. No API key exists or is needed.
SLEEPER_USERNAME=kmo2713

# Which NFL season to sync. Leave blank to follow Sleeper's /state/nfl.
# SNAP_COUNT_SEASON=2026

# Shared secret required by POST /api/sync so the endpoint is not open to the
# internet once deployed. Generate with: openssl rand -hex 32
SYNC_SECRET=

# --- Not wired up yet (phases 4-6 of the build order) ----------------------
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
# YAHOO_REDIRECT_URI=http://localhost:3000/api/auth/yahoo/callback
# ESPN_S2=
# ESPN_SWID=
# CREDENTIAL_ENCRYPTION_KEY=   # 32-byte hex, for encrypting stored tokens/cookies
# ANTHROPIC_API_KEY=           # for Claude-generated start/sit + trade analysis
